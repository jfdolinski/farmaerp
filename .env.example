# Valores apenas para desenvolvimento local. Copie para .env.
# Em produção, os segredos são definidos no EasyPanel.

# development, homologation ou production. Sem valor válido, a API não inicia.
APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=farmaerp

# Administrador do Postgres: usado só para preparar o banco de testes.
POSTGRES_PASSWORD=dev_admin_troque

# Dono das tabelas: roda as migrations.
FARMAERP_MIGRATOR_PASSWORD=dev_migrator_troque

# Usado pela API: sempre sujeito à Row Level Security.
FARMAERP_APP_PASSWORD=dev_app_troque

# Assina os desafios e tokens dos terminais. Mínimo de 32 caracteres.
TERMINAL_TOKEN_SECRET=dev_token_secret_troque_em_cada_ambiente

# Criptografa certificado A1 e CSC: 32 bytes em base64. Sem ela, a API sobe, mas o envio de certificado responde FA915.
# Gere uma por ambiente: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FISCAL_ENCRYPTION_KEY=ZGV2LWZpc2NhbC1rZXktc29tZW50ZS1kZXYtMTIzNDU=

# Acesso local: admin@farmaerp.test e operador@farmaerp.test, com a senha farmaerp-dev-123 (só no seed de desenvolvimento).
